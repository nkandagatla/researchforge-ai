# Copy to .env. Anything blank can also be entered in the app sidebar.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
TAVILY_API_KEY=
PARALLEL_API_KEY=
# Optional tracing (off by default; sidebar toggle or run_cli.py --trace)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=researchforge
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional: Hugging Face token for faster model downloads (HF_API_KEY also accepted)
HF_TOKEN=
# Optional: per-run spend cap for the supervisor's extra loops (USD)
RF_BUDGET_USD=0.25
